{
    "tag": "1C Integration",
    "description": "OpenCart tvim.az layihəsində işləyən 1C REST endpoint-lərinin Laravel (ayti e-commerce) üzərinə 1:1 köçürülmüş versiyası. URL-lər və HTTP method-lar dəyişmir. Response format OpenCart ApiController::sendResponse() ilə eynidir: {success: 1|0, error: [], data: ...}.",
    "basePathNote": "Bütün endpoint-lər public URL-dadır, amma Authorization Bearer token tələb edir (ONEC_BEARER_TOKENS). Base path: /api/1c. JSON body-lər OpenCart getPost() davranışı kimi yoxlanır: body array/object olmalıdır və boş olmamalıdır (əks halda 400). OPTIONS preflight 200 qaytarır.",
    "headers": {
        "Authorization": {
            "type": "text",
            "required": true,
            "description": "Bearer token. OpenCart validateToken() davranışının Laravel analoqu. Token-lər env/config-dən oxunur: ONEC_BEARER_TOKENS (vergüllə).",
            "example": "Bearer 44pyDpQTx3wYkLMW58mVpYSEGayN5K2mKavOoC2ydQXcoEc6HTl2K2WPj7gAfSwF..."
        },
        "Content-Type": {
            "type": "text",
            "required": true,
            "description": "JSON payload üçün application/json göndərilməlidir.",
            "example": "application/json"
        },
        "Origin": {
            "type": "text",
            "required": false,
            "description": "Əgər göndərilərsə, CORS header-lar OpenCart kimi echo edilir (Access-Control-Allow-*).",
            "example": "https://1c.example.local"
        },
        "X-Request-Id": {
            "type": "text",
            "required": false,
            "description": "Log-lar üçün request correlation id. ActivityLogService request_id kimi saxlayır.",
            "example": "req_01HTX0KZ4G7E2J8WZQ"
        }
    },
    "cookie": {},
    "endpoints": [
        {
            "path": "/1c/category/add",
            "method": "post",
            "summary": "Category add (bulk)",
            "description": "1C kateqoriyaları göndərir. OpenCart-də category GUID kimi saxlanırdı. Laravel-də menus cədvəlinə yazılır (menus.type=categories, uuid=GUID). Body array olmalıdır.",
            "authorization": "Authorization: Bearer <token>",
            "query": {},
            "pathParams": {},
            "formData": false,
            "body": {
                "type": "json",
                "required": true,
                "description": "Array of category objects.",
                "example": [
                    {
                        "id": "b0b9c0a8-1f2b-4f8c-9c7c-00b1a9b1a111",
                        "parentId": "00000000-0000-0000-0000-000000000000",
                        "name": "Elektronika"
                    },
                    {
                        "id": "c0c9d0a8-1f2b-4f8c-9c7c-00b1a9b1a222",
                        "parentId": "b0b9c0a8-1f2b-4f8c-9c7c-00b1a9b1a111",
                        "name": "Telefonlar"
                    }
                ]
            },
            "responses": {
                "200": {
                    "success": 1,
                    "error": [],
                    "data": []
                },
                "400": {
                    "success": 0,
                    "error": [
                        "Invalid request body, please validate the json object"
                    ],
                    "data": []
                },
                "403": {
                    "success": 0,
                    "error": [
                        "error_permission"
                    ],
                    "data": []
                },
                "405": {
                    "success": 0,
                    "error": [
                        "Method Not Allowed"
                    ],
                    "data": []
                }
            }
        },
        {
            "path": "/1c/category/edit/{category_id}",
            "method": "put",
            "summary": "Category edit (single)",
            "description": "category_id route param OpenCart-də GUID idi. Laravel-də də GUID kimi qəbul edilir (menus.uuid). Əgər GUID tapılmazsa 404 qaytarır.",
            "authorization": "Authorization: Bearer <token>",
            "pathParams": {
                "category_id": {
                    "type": "text",
                    "required": true,
                    "description": "Category GUID (OpenCart category.GUID).",
                    "example": "c0c9d0a8-1f2b-4f8c-9c7c-00b1a9b1a222"
                }
            },
            "query": {},
            "formData": false,
            "body": {
                "type": "json",
                "required": true,
                "description": "Category object. (id göndərilməsə belə route param ilə override edilir).",
                "example": {
                    "parentId": "b0b9c0a8-1f2b-4f8c-9c7c-00b1a9b1a111",
                    "name": "Telefonlar (yenilənib)"
                }
            },
            "responses": {
                "200": {
                    "success": 1,
                    "error": [],
                    "data": []
                },
                "404": {
                    "success": 0,
                    "error": [
                        "error_no_category"
                    ],
                    "data": []
                },
                "400": {
                    "success": 0,
                    "error": [
                        "Invalid request body, please validate the json object"
                    ],
                    "data": []
                }
            }
        },
