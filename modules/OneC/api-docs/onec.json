        {
            "path": "/1c/product/add",
            "method": "post",
            "summary": "Product add (bulk)",
            "description": "1C məhsul göndərir. Laravel-də əvvəl products table-də Product yaradılır (uuid=GUID), sonra həmin məhsul üçün 1 variation yaradılır/yenilənir. Body array olmalıdır. unit_id/unit_value qəbul edilmir (1C artıq göndərmir).",
            "authorization": "Authorization: Bearer <token>",
            "query": {},
            "pathParams": {},
            "formData": false,
            "body": {
                "type": "json",
                "required": true,
                "description": "Array of product objects.",
                "example": [
                    {
                        "id": "p-uuid-iphone-15-111",
                        "name": "iPhone 15 128GB",
                        "SKU": "IP15-128-BLK",
                        "quantity": 12,
                        "price": 1899.99,
                        "discount": 1799.99,
                        "brendId": "m-uuid-apple-333",
                        "categoryId": "c0c9d0a8-1f2b-4f8c-9c7c-00b1a9b1a222",
                        "status": 1,
                        "description": "<p>Məhsul təsviri...</p>",
                        "tag": "iphone, apple",
                        "options": [
                            {
                                "name": "Rəng",
                                "value": "Qara"
                            }
                        ]
                    }
                ]
            },
            "responses": {
                "200": {
                    "success": 1,
                    "error": [],
                    "data": []
                },
                "400": {
                    "success": 0,
                    "error": [
                        "Invalid request body, please validate the json object"
                    ],
                    "data": []
                },
                "403": {
                    "success": 0,
                    "error": [
                        "error_permission"
                    ],
                    "data": []
                }
            }
        },
