{
    "tag": "Authentication",
    "description": "Customer authentication APIs for registration, login, OTP verification, password reset, logout, token refresh, and password change operations.",
    "endpoints": [
        {
            "path": "/customer/auth/register",
            "method": "post",
            "summary": "Register a new customer",
            "description": "Creates a new customer account and sends an email verification OTP. If the email already exists and is not verified, the existing customer record is updated and a new email verification OTP is sent. If the email is already verified, registration is blocked. Login is not allowed until the email is verified.",
            "formBody": {
                "name": {
                    "type": "text",
                    "required": true,
                    "description": "Customer first name.",
                    "default": "John"
                },
                "surname": {
                    "type": "text",
                    "required": false,
                    "description": "Customer last name.",
                    "default": "Doe"
                },
                "passport_fin": {
                    "type": "text",
                    "required": false,
                    "description": "Customer passport FIN code.",
                    "default": "ABC1234"
                },
                "date_of_birth": {
                    "type": "text",
                    "required": false,
                    "description": "Customer date of birth. Expected format: YYYY-MM-DD.",
                    "default": "1995-01-15"
                },
                "email": {
                    "type": "text",
                    "required": true,
                    "description": "Customer email address. The email must be unique for verified customers. If an unverified customer exists with the same email, that record is updated instead of creating a duplicate record.",
                    "default": "user@example.com"
                },
                "phone": {
                    "type": "text",
                    "required": false,
                    "description": "Customer phone number.",
                    "default": "0511111111"
                },
                "country_id": {
                    "type": "number",
                    "required": false,
                    "description": "Country ID. This field is nullable.",
                    "default": 1
                },
                "password": {
                    "type": "text",
                    "required": true,
                    "description": "Customer password. Password policy is applied.",
                    "default": "Ee12345678!@#"
                },
                "password_confirmation": {
                    "type": "text",
                    "required": true,
                    "description": "Password confirmation.",
                    "default": "Ee12345678!@#"
                }
            },
            "responses": {
                "201": {
                    "token": "1|4WHKo6K0AZNGiPiL9QWs1qXZ2CwnYbaCQyfUYr8M1f224977",
                    "user": {
                        "id": 1,
                        "name": "John",
                        "surname": "Doe",
                        "email": "user@example.com",
                        "email_verified_at": null,
                        "phone": "0511111111",
                        "country_id": 1,
                        "avatar_path": null,
                        "is_active": true,
                        "created_at": "2026-02-13T10:00:00.000000Z",
                        "updated_at": "2026-02-13T10:00:00.000000Z"
                    },
                    "message": "Your account has been created successfully. A verification code has been sent to your email."
                },
                "422": {
                    "name": [
                        "Please enter your name."
                    ],
                    "email": [
                        "This email is already registered."
                    ],
                    "password": [
                        "Password confirmation does not match."
                    ],
                    "password_confirmation": [
                        "Please confirm your password."
                    ]
                }
            }
        },
        {
            "path": "/customer/auth/login",
            "method": "post",
            "summary": "Customer login",
            "description": "Authenticates a customer account. If the email is not verified, login is blocked and requires_email_verification is returned. If the account is disabled, a 403 response is returned.",
            "formBody": {
                "email": {
                    "type": "text",
                    "required": true,
                    "description": "Customer email address.",
                    "default": "user@example.com"
                },
                "password": {
                    "type": "text",
                    "required": true,
                    "description": "Customer password.",
                    "default": "Ee12345678!@#"
                }
            },
            "responses": {
                "200": {
                    "token": "1|4WHKo6K0AZNGiPiL9QWs1qXZ2CwnYbaCQyfUYr8M1f224977",
                    "user": {
                        "id": 1,
                        "name": "John",
                        "surname": "Doe",
                        "email": "user@example.com",
                        "email_verified_at": "2026-02-13T10:00:00.000000Z",
                        "phone": "0511111111",
                        "country_id": 1,
                        "avatar_path": "public/customers/1/avatars/avatar.jpg",
                        "is_active": true,
                        "created_at": "2026-02-13T10:00:00.000000Z",
                        "updated_at": "2026-02-13T10:00:00.000000Z"
                    }
                },
                "422": {
                    "message": [
                        "Email is not verified. Please verify your email using the OTP code."
                    ],
                    "requires_email_verification": [
                        "1"
                    ]
                },
                "403": {
                    "message": "Account is disabled."
                }
            }
        },
        {
            "path": "/customer/auth/forgot-password",
            "method": "post",
            "summary": "Send password reset OTP",
            "description": "Sends a password reset OTP if the email exists. OTP type: password_reset. For security reasons, the endpoint returns the same 200 response even when the email does not exist.",
            "formBody": {
                "email": {
                    "type": "text",
                    "required": true,
                    "description": "Customer email address.",
                    "default": "user@example.com"
                }
            },
            "responses": {
                "200": {
                    "message": "If the email is registered, a password reset code has been sent."
                },
                "422": {
                    "email": [
                        "Please enter a valid email address."
                    ]
                }
            }
        },
        {
            "path": "/customer/auth/otp/verify",
            "method": "post",
            "summary": "Verify OTP",
            "description": "Handles all customer OTP verification flows. For email verification, send type=email_verification. For password reset, send type=password_reset together with password and password_confirmation. OTP must be exactly 4 digits. Invalid attempts increase the attempt counter. Used, expired, or invalid OTP codes are rejected.",
            "formBody": {
                "email": {
                    "type": "text",
                    "required": true,
                    "description": "Customer email address.",
                    "default": "user@example.com"
                },
                "code": {
                    "type": "text",
                    "required": true,
                    "description": "The 4-digit OTP code sent to the customer email address.",
                    "default": "1234"
                },
                "type": {
                    "type": "select",
                    "required": true,
                    "description": "OTP verification type. Allowed values: email_verification, password_reset.",
                    "default": "email_verification",
                    "options": [
                        "email_verification",
                        "password_reset"
                    ]
                },
                "password": {
                    "type": "text",
                    "required": false,
                    "description": "New password. Required only when type=password_reset. Password policy is applied.",
                    "default": "Ee12345678!@#"
                },
                "password_confirmation": {
                    "type": "text",
                    "required": false,
                    "description": "New password confirmation. Required only when type=password_reset.",
                    "default": "Ee12345678!@#"
                }
            },
            "examples": {
                "email_verification": {
                    "email": "user@example.com",
                    "code": "1234",
                    "type": "email_verification"
                },
                "password_reset": {
                    "email": "user@example.com",
                    "code": "1234",
                    "type": "password_reset",
                    "password": "Ee12345678!@#",
                    "password_confirmation": "Ee12345678!@#"
                }
            },
            "responses": {
                "200_email_verification": {
                    "message": "Email has been successfully verified."
                },
                "200_email_already_verified": {
                    "message": "Email has already been verified."
                },
                "200_password_reset": {
                    "message": "Password has been successfully reset."
                },
                "422": {
                    "email": [
                        "User with this email was not found."
                    ],
                    "code": [
                        "Verification code is incorrect."
                    ],
                    "type": [
                        "Selected verification type is invalid."
                    ],
                    "password": [
                        "Please enter your new password."
                    ],
                    "password_confirmation": [
                        "Please confirm your new password."
                    ]
                }
            }
        },
        {
            "path": "/customer/auth/email/resend",
            "method": "post",
            "summary": "Resend email verification OTP",
            "description": "Sends a new email verification OTP if the customer email is not verified. If the email does not exist or is already verified, the endpoint still returns a 200 response for security and idempotency.",
            "formBody": {
                "email": {
                    "type": "text",
                    "required": true,
                    "description": "Customer email address.",
                    "default": "user@example.com"
                }
            },
            "responses": {
                "200": {
                    "message": "Verification code has been resent successfully."
                },
                "422": {
                    "email": [
                        "Please enter a valid email address."
                    ]
                }
            }
        },
        {
            "path": "/customer/auth/logout",
            "method": "post",
            "summary": "Customer logout",
            "description": "Deletes all active tokens for the authenticated customer and logs the customer out.",
            "authorization": true,
            "responses": {
                "200": {
                    "message": "Successfully logged out."
                },
                "401": {
                    "message": "Unauthenticated."
                }
            }
        },
        {
            "path": "/customer/auth/user",
            "method": "get",
            "summary": "Get authenticated customer",
            "description": "Returns the customer data associated with the active access token.",
            "authorization": true,
            "responses": {
                "200": {
                    "id": 1,
                    "name": "John",
                    "surname": "Doe",
                    "email": "user@example.com",
                    "email_verified_at": "2026-02-13T10:00:00.000000Z",
                    "phone": "0511111111",
                    "country_id": 1,
                    "avatar_path": "public/customers/1/avatars/avatar.jpg",
                    "is_active": true,
                    "created_at": "2026-02-13T10:00:00.000000Z",
                    "updated_at": "2026-02-13T10:00:00.000000Z"
                },
                "401": {
                    "message": "Unauthenticated."
                }
            }
        },
        {
            "path": "/customer/auth/refresh",
            "method": "post",
            "summary": "Refresh access token",
            "description": "Deletes all existing tokens for the authenticated customer and creates a new access token.",
            "authorization": true,
            "responses": {
                "200": {
                    "token": "1|NEW_TOKEN_EXAMPLE_XXXXXXXXXXXXXXXXXXXXXXXX"
                },
                "401": {
                    "message": "Unauthenticated."
                }
            }
        },
        {
            "path": "/customer/auth/change-password",
            "method": "post",
            "summary": "Change password",
            "description": "Allows the authenticated customer to change the password after confirming the current password. All tokens are deleted after a successful password change, and the customer must log in again.",
            "authorization": true,
            "formBody": {
                "current_password": {
                    "type": "text",
                    "required": true,
                    "description": "Current password.",
                    "default": "Ee12345678!@#"
                },
                "password": {
                    "type": "text",
                    "required": true,
                    "description": "New password. Password policy is applied.",
                    "default": "NewPassword123!@#"
                },
                "password_confirmation": {
                    "type": "text",
                    "required": true,
                    "description": "New password confirmation.",
                    "default": "NewPassword123!@#"
                }
            },
            "responses": {
                "200": {
                    "message": "Password has been successfully changed."
                },
                "401": {
                    "message": "Unauthenticated."
                },
                "422": {
                    "current_password": [
                        "Current password is incorrect."
                    ],
                    "password": [
                        "Password confirmation does not match."
                    ]
                }
            }
        }
    ],
    "deprecatedEndpoints": [
        {
            "path": "/customer/auth/email/verify",
            "method": "post",
            "replacement": "/customer/auth/otp/verify",
            "description": "Email OTP verification is now handled by the unified OTP verification endpoint. Send type=email_verification."
        },
        {
            "path": "/customer/auth/reset-password",
            "method": "post",
            "replacement": "/customer/auth/otp/verify",
            "description": "Password reset is now handled by the unified OTP verification endpoint. Send type=password_reset."
        }
    ]
}
