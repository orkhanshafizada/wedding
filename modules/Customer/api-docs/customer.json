{
    "tag": "Customer",
    "description": "Customer profil və ünvanlar ilə bağlı API-lər.",
    "basePathNote": "Base path: /v1. Bu modulun endpoint-ləri /customer/* altında işləyir. Authorization tələb edən endpoint-lərdə header: Authorization: Bearer {token}.",
    "headers": {
        "Authorization": {
            "type": "string",
            "required": false,
            "description": "Auth customer üçün Bearer token. Bu header göndərilməyən endpoint-lər 401 qaytara bilər.",
            "example": "Bearer 1|4WHKo6K0AZNGiPiL9QWs1qXZ2CwnYbaCQyfUYr8M1f224977"
        },
        "X-Cart-Token": {
            "type": "string",
            "required": false,
            "description": "Guest cart token. Login/Register zamanı göndərilərsə guest cart customer cart-a merge oluna bilər. Token yalnız header/cookie ilə göndərilir (body-də yox). Prioritet 1.",
            "example": "eE2xw7h3pK0mQ1...40chars"
        },
        "Cart-Token": {
            "type": "string",
            "required": false,
            "description": "X-Cart-Token alternativ header adı. X-Cart-Token boşdursa oxunur. Prioritet 2.",
            "example": "eE2xw7h3pK0mQ1...40chars"
        }
    },
    "cookie": {
        "cart_token": {
            "type": "string",
            "required": false,
            "description": "Guest cart token cookie-dən də oxuna bilər (header-lər boşdursa). Prioritet 3.",
            "example": "eE2xw7h3pK0mQ1...40chars"
        }
    },
