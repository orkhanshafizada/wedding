{
    "tag": "Menu",
    "description": "Menu list, scoped menu trees for header, footer, main_page_menus, menu detail by type, included menu items, and menu based public form submit APIs.",
    "basePathNote": "These endpoints work under the /v1 route group prefix. They are public endpoints and do not require authorization. By default, only active menus (status=true) are returned.",
    "headers": {},
    "cookie": {},
    "endpoints": [
        {
            "path": "/menus",
            "method": "get",
            "summary": "Menu list grouped by main_page_menus, header, and footer",
            "description": "Returns active menus grouped into main_page_menus, header, and footer. Each grouped tree is scoped by its own visibility flag. For example, header contains only menus where in_header=true, and every child inside header must also have in_header=true. If a parent has in_header=true but a child has in_header=false, that child is not returned. The same rule applies to main_page_menus by show_on_main_page=true and footer by in_footer=true. Query filters can still be used. If in_header=true, in_footer=true, or show_on_main_page=true is sent, the response returns only the requested sections. Menu translation fields are selected by locale and fallback locale. Field-level fallback is applied, for example if title is empty in the selected locale, fallback locale or another available translation value is used. Included menu items are returned inside each menu resource as included_items when available.",
            "authorization": "Public. Authorization is not required.",
            "formBody": {},
            "query": {
                "status": {
                    "type": "boolean",
                    "required": false,
                    "description": "Filter by menu status. If not provided, status=true is applied by default.",
                    "example": true
                },
                "in_header": {
                    "type": "boolean",
                    "required": false,
                    "description": "Filter by header visibility. If true is sent, the response returns header only. Menus and children inside header must all have in_header=true.",
                    "example": true
                },
                "show_on_main_page": {
                    "type": "boolean",
                    "required": false,
                    "description": "Filter by main page visibility. If true is sent, the response returns main_page_menus only. Menus and children inside main_page_menus must all have show_on_main_page=true.",
                    "example": true
                },
                "in_footer": {
                    "type": "boolean",
                    "required": false,
                    "description": "Filter by footer visibility. If true is sent, the response returns footer only. Menus and children inside footer must all have in_footer=true.",
                    "example": true
                },
                "type": {
                    "type": "text",
                    "required": false,
                    "description": "Filter by menu type. Examples: categories, content, contact, link, faq, teamstaff, logospartners, form, grids, photo_gallery, video_gallery, files.",
                    "example": "categories"
                },
                "view_type": {
                    "type": "text",
                    "required": false,
                    "description": "Exact match filter by menus.view_type. If it is empty in database, the API returns default as view_type.",
                    "example": "blog"
                },
                "parent_id": {
                    "type": "number",
                    "required": false,
                    "description": "Filter by parent_id. Example: parent_id=5 returns only children of that parent.",
                    "example": 5
                },
                "link": {
                    "type": "text",
                    "required": false,
                    "description": "Exact match filter by menu_translations.link. If the value does not start with /, it is normalized automatically.",
                    "example": "/about-us"
                },
                "q": {
                    "type": "text",
                    "required": false,
                    "description": "Search by resolved menu name.",
                    "example": "about"
                },
                "locale": {
                    "type": "text",
                    "required": false,
                    "description": "Locale code used for translated menu fields. If not provided, the application locale is used.",
                    "example": "en"
                },
                "with_children": {
                    "type": "boolean",
                    "required": false,
                    "description": "Accepted for backward compatibility. The current grouped response always returns scoped menu trees for main_page_menus, header, and footer.",
                    "example": true
                }
            },
            "formData": false,
