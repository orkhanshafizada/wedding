        {
            "path": "/menus/detail",
            "method": "get",
            "summary": "Menu detail by type with optional data_slug",
            "description": "Finds a menu by link and calls a type-specific handler based on menu.type. If data_slug is sent, the endpoint returns detail data from the selected menu type data source. For example, for type=grids and view_type=blog, data_slug can be a concrete post slug and the endpoint returns that post detail instead of the list. If a handler is not found, 404 is returned. The menu object always returns view_type; if it is empty in database, default is returned. If locale query parameter is provided, menu translation fields are returned using locale and fallback locale. Field-level fallback is applied for title and description. Included menu, slider, and brand items are returned in included_items.",
            "authorization": "Public. Authorization is not required.",
            "formBody": {},
            "query": {
                "link": {
                    "type": "text",
                    "required": true,
                    "description": "Menu link or slug. It is searched by menu_translations.link. If it does not start with /, it is normalized automatically.",
                    "example": "blogs"
                },
                "data_slug": {
                    "type": "text",
                    "required": false,
                    "description": "Optional data detail selector based on menu type. Example: for type=grids and view_type=blog, this is the post slug and returns one post detail instead of the list.",
                    "example": "today-important-news"
                },
                "page": {
                    "type": "number",
                    "required": false,
                    "description": "Pagination page for list-based menu types when data_slug is not sent.",
                    "example": 1
                },
                "per_page": {
                    "type": "number",
                    "required": false,
                    "description": "Pagination per page for list-based menu types when data_slug is not sent. Default is 12, maximum is 100.",
                    "example": 12
                },
                "locale": {
                    "type": "text",
                    "required": false,
                    "description": "Locale code used for translated menu fields. If not provided, the application locale is used.",
                    "example": "en"
                }
            },
            "formData": false,
