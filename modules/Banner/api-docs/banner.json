{
    "tag": "Banner",
    "description": "API for retrieving active banners, either grouped by position or for a specific position.",
    "endpoints": [
        {
            "path": "/banners",
            "method": "get",
            "summary": "Retrieve all active banners",
            "description": "Returns only banners where is_active=true. Results are grouped by position. Within each position, banners are sorted by sort_order.",
            "parameters": {},
            "responses": {
                "200": {
                    "success": true,
                    "message": "Banners loaded successfully",
                    "data": [
                        {
                            "position": "991199",
                            "position_name": "Home Page 1",
                            "banners": [
                                {
                                    "id": 1,
                                    "image": "http://example.com/storage/banners/az_banner_abc123.jpg",
                                    "mobile_image": "http://example.com/storage/banners/az_banner_mobile_abc123.jpg",
                                    "title": "Promo",
                                    "description": "Some description text",
                                    "hide_text_mobile": true,
                                    "link": "https://example.com/promo",
                                    "sort_order": 0
                                },
                                {
                                    "id": 2,
                                    "image": "http://example.com/storage/banners/az_banner_def456.jpg",
                                    "mobile_image": null,
                                    "title": "Sale",
                                    "description": null,
                                    "hide_text_mobile": false,
                                    "link": "https://example.com/sale",
                                    "sort_order": 1
                                }
                            ]
                        },
                        {
                            "position": "992299",
                            "position_name": "Home Page 2",
                            "banners": [
                                {
                                    "id": 3,
                                    "image": "http://example.com/storage/banners/az_banner_ghi789.jpg",
                                    "mobile_image": "http://example.com/storage/banners/az_banner_mobile_ghi789.jpg",
                                    "title": "New Arrivals",
                                    "description": "Check new products",
                                    "hide_text_mobile": false,
                                    "link": "https://example.com/new-arrivals",
                                    "sort_order": 0
                                }
                            ]
                        },
                        {
                            "position": "5",
                            "position_name": "Phones",
                            "banners": [
                                {
                                    "id": 4,
                                    "image": "http://example.com/storage/banners/az_banner_jkl012.jpg",
                                    "mobile_image": null,
                                    "title": "Phones Sale",
                                    "description": null,
                                    "hide_text_mobile": true,
                                    "link": "https://example.com/phones-sale",
                                    "sort_order": 0
                                }
                            ]
                        }
                    ]
                },
                "500": {
                    "success": false,
                    "message": "Server Error",
                    "data": []
                }
            },
            "notes": [
                "Only banners with is_active=true are returned",
                "Results are grouped by position",
                "Within each position, banners are returned in ascending order by sort_order",
                "image and mobile_image are taken from the banner_translations table for the current locale",
                "Translations are resolved according to the current locale",
                "If no translation exists for the current language, the first available translation is returned",
                "image and mobile_image are returned as full URLs",
                "Authentication is not required"
            ]
        },
        {
            "path": "/banners/{position}",
            "method": "get",
            "summary": "Retrieve banners for a specific position",
            "description": "Returns active banners for the given position ID. Position may be '991199', '992299', or a Menu ID.",
            "parameters": {
                "position": {
                    "in": "path",
                    "required": true,
                    "type": "string",
                    "description": "Position ID: '991199', '992299', or Category Menu ID",
                    "examples": [
                        "991199",
                        "992299",
                        "5",
                        "12"
                    ]
                }
            },
            "responses": {
                "200": {
                    "success": true,
                    "message": "Banners loaded successfully",
                    "data": {
                        "position": "991199",
                        "position_name": "Home Page 1",
                        "banners": [
                            {
                                "id": 1,
                                "image": "http://example.com/storage/banners/az_banner_abc123.jpg",
                                "mobile_image": "http://example.com/storage/banners/az_banner_mobile_abc123.jpg",
                                "title": "Promo",
                                "description": "Some description text",
                                "hide_text_mobile": true,
                                "link": "https://example.com/promo",
                                "sort_order": 0
                            },
                            {
                                "id": 2,
                                "image": "http://example.com/storage/banners/az_banner_def456.jpg",
                                "mobile_image": null,
                                "title": "Sale",
                                "description": null,
                                "hide_text_mobile": false,
                                "link": "https://example.com/sale",
                                "sort_order": 1
                            }
                        ]
                    }
                },
                "200_empty": {
                    "success": true,
                    "message": "No banners found for this position",
                    "data": []
                },
                "500": {
                    "success": false,
                    "message": "Server Error",
                    "data": []
                }
            },
            "notes": [
                "Only banners with is_active=true are returned",
                "Results are returned in ascending order by sort_order",
                "image and mobile_image are taken from the banner_translations table for the current locale",
                "Translations are resolved according to the current locale",
                "If no translation exists for the current language, the first available translation is returned",
                "If no banners are found, an empty array is returned",
                "Position '991199' = Home Page 1",
                "Position '992299' = Home Page 2",
                "Other position IDs correspond to categories from the Menu table",
                "Authentication is not required"
            ]
        }
    ]
}
