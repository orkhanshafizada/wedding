{
    "tag": "Order",
    "description": "Order API-ləri. Checkout zamanı lazım olan çatdırılma seçimləri, promo kod yoxlamaları, database əsaslı payment method-lar, installment plan məlumatları və ödəniş callback-ləri bu bölmədə verilir.",
    "basePathNote": "Bu endpoint-lər /v1 prefix-i route group daxilində avtomatik əlavə olunduğu üçün burada path-lar /v1 yazılmadan göstərilir.",
    "headers": {
        "Authorization": {
            "type": "string",
            "required": false,
            "description": "Auth customer üçün Bearer token. Authorization: Bearer {token}",
            "example": "Bearer 1|4WHKo6K0AZNGiPiL9QWs1qXZ2CwnYbaCQyfUYr8M1f224977"
        },
        "X-Guest-Token": {
            "type": "string",
            "required": false,
            "description": "Guest üçün səbət token-i. Checkout və guest sifariş detailində istifadə oluna bilər.",
            "example": "eE2xw7h3pK0mQ1nR8tY6uV4sW2xZ9aB7cD5eF1gH"
        }
    },
    "cookie": {
        "cart_token": {
            "type": "string",
            "required": false,
            "description": "Guest üçün səbət token-i cookie üzərindən.",
            "example": "eE2xw7h3pK0mQ1nR8tY6uV4sW2xZ9aB7cD5eF1gH"
        }
    },
    "endpoints": [
        {
            "path": "/order/delivery-prices",
            "method": "get",
            "summary": "Çatdırılma qiymətləri siyahısı",
            "description": "Aktiv olan çatdırılma variantlarını qaytarır. İstəyə görə q query parametri ilə name üzrə axtarış, parent_id ilə isə parent-child filtr tətbiq edilə bilər. parent_id=0 olduqda yalnız root/main delivery price-lar qaytarılır.",
            "authorization": "Public",
            "query": {
                "q": {
                    "type": "string",
                    "required": false,
                    "description": "Axtarış (name üzrə)",
                    "example": "Bakı"
                },
                "parent_id": {
                    "type": "number",
                    "required": false,
                    "description": "Parent delivery price ID-si üzrə filtr. 0 göndərilərsə root/main delivery price-lar qaytarılır.",
                    "example": 0
                }
            },
            "formData": false,
            "formBody": {},
            "responses": {
                "200": {
                    "success": true,
                    "message": "OK",
                    "data": [
                        {
                            "id": 1,
                            "parent_id": 0,
                            "parent_name": null,
                            "name": "Bakı",
                            "price": 5,
                            "status": "Active",
                            "sort_order": 0
                        },
                        {
                            "id": 2,
                            "parent_id": 1,
                            "parent_name": "Bakı",
                            "name": "Nərimanov",
                            "price": 7,
                            "status": "Active",
                            "sort_order": 1
                        }
                    ]
                },
                "500": {
                    "success": false,
                    "message": "Server Error",
                    "data": []
                }
            }
        },
        {
            "path": "/order/delivery-prices/{id}",
            "method": "get",
            "summary": "Çatdırılma qiyməti detayı",
            "description": "Verilən ID-yə uyğun çatdırılma variantını qaytarır. Variant aktiv deyilsə 404 qaytarır. Response daxilində parent_id və parent_name də qaytarılır.",
            "authorization": "Public",
            "query": {},
            "formData": false,
            "formBody": {},
            "responses": {
                "200": {
                    "success": true,
                    "message": "OK",
                    "data": {
                        "id": 2,
                        "parent_id": 1,
                        "parent_name": "Bakı",
                        "name": "Nərimanov",
                        "price": 7,
                        "status": "Active",
                        "sort_order": 1
                    }
                },
                "404": {
                    "success": false,
                    "message": "Seçilən çatdırılma variantı aktiv deyil.",
                    "data": []
                },
                "500": {
                    "success": false,
                    "message": "Server Error",
                    "data": []
                }
            }
        },
        {
