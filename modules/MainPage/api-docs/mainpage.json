        "Content-Language": {
            "type": "text",
            "required": true,
            "description": "Language header. Example: az | en | ru. Middleware sets the application locale according to this header.",
            "example": "az"
        },
        "Authorization": {
            "type": "string",
            "required": false,
            "description": "Not required for this endpoint. This is a public endpoint.",
            "example": "Bearer 1|4WHKo6K0AZNGiPiL9QWs1qXZ2CwnYbaCQyfUYr8M1f224977"
        }
    },
