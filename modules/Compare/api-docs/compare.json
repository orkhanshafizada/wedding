{
    "tag": "Compare",
    "description": "Compare APIs. For authenticated customers, compare works by customer_id. For guests, compare works only by X-Guest-Token.\n\nGuest requests use only the X-Guest-Token header.\nX-Compare-Token, Compare-Token, compare_token cookie and other legacy token mechanisms are not used.\n\nGuest token is created from the common Settings API endpoint: POST /v1/guest-token.\nThe same X-Guest-Token is used for Cart, Compare and Favorites.\n\nCompare is managed only by product variation through product_variation_id. The toggle endpoint adds the variation if it does not exist in compare, and removes it if it already exists.\n\nDuring Login/Register, if X-Guest-Token is sent, guest compare items can be merged into the customer account.\n\nVariation filters are returned in the same grouped structure as Product Detail API. Filters are sorted by filter sort_order and values are sorted by value sort_order.",
    "basePathNote": "Base path: /v1",
    "headers": {
        "Authorization": {
            "type": "string",
            "required": false,
            "description": "Bearer token for authenticated customers using customer-api guard.",
            "example": "Bearer eyJ0eXAiOiJKV1QiLCJhbGciOi..."
        },
        "X-Guest-Token": {
            "type": "string",
            "required": false,
            "description": "The only token header for guest Cart, Compare and Favorites. It is not sent in the request body and is used only as a header.",
            "example": "kKp9w3Qq5z8hYfJ2mN1aB0cD7eR4tU6vX3sW2pL1"
        }
    },
    "endpoints": [
        {
            "path": "/compare",
            "method": "get",
            "summary": "Compare list",
            "description": "Returns paginated compare items. Default per_page is 20.\nFor authenticated customers, items are returned by customer_id.\nFor guests, items are returned only by X-Guest-Token.\nIf no token is sent for a guest request, an empty list is returned.\nRecommended flow: create a guest token once with POST /v1/guest-token and send it as X-Guest-Token in all guest Cart, Compare and Favorites requests.",
            "authorization": false,
            "query": {
                "page": {
                    "type": "number",
                    "required": false,
                    "description": "Page number",
                    "example": 1
                },
                "per_page": {
                    "type": "number",
                    "required": false,
                    "description": "Items per page. Minimum 1, maximum 100, default 20.",
                    "example": 20
                }
            },
            "formData": false,
