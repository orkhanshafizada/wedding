        {
            "path": "/compare/toggle",
            "method": "post",
            "summary": "Toggle compare item",
            "description": "Sends product_variation_id.\nFor authenticated customers, compare works by customer_id.\nFor guests, compare works by X-Guest-Token.\nThe response returns action: created or deleted.\n\nRecommended flow: create a guest token once with POST /v1/guest-token and send it as X-Guest-Token.\nIf a guest request does not include a token, backend can generate a token and return it as data.token. The client must send that token as X-Guest-Token in the next guest Cart, Compare and Favorites requests.\n\nWhen action is created, compare.variation.filters is returned in grouped and sorted format. Filters are sorted by product_filters.sort_order and values are sorted by product_filter_values.sort_order.",
            "authorization": false,
            "query": {},
            "formData": false,
            "formBody": {
                "product_variation_id": {
                    "type": "number",
                    "required": true,
                    "description": "Product variation ID to toggle.",
                    "example": 101
                }
            },
            "responses": {
                "200": {
                    "success": true,
                    "message": "Removed from compare",
                    "data": {
                        "token": "kKp9w3Qq5z8hYfJ2mN1aB0cD7eR4tU6vX3sW2pL1",
                        "action": "deleted",
                        "compare": null
                    }
                },
