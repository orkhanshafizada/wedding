{
    "tag": "Cart",
    "description": "Cart APIs. For authenticated customers, cart is managed by customer_id. For guests, cart is managed only by X-Guest-Token.\n\nGuest requests use only the X-Guest-Token header.\nX-Cart-Token, Cart-Token, cart_token cookie and other legacy token mechanisms are not used.\n\nGuest token is created from the common Settings API endpoint: POST /v1/guest-token.\nThe same X-Guest-Token is used for Cart, Compare and Favorites.\n\nIf X-Guest-Token is not sent to cart write endpoints, backend can create a new active guest cart and return data.token in the cart response. However, recommended frontend flow is to create a guest token once with POST /v1/guest-token and send it in all guest Cart, Compare and Favorites requests.",
    "basePathNote": "These endpoints work with the /v1 prefix.",
    "headers": {
        "X-Guest-Token": {
            "type": "string",
            "required": false,
            "description": "The only token header for guest Cart, Compare and Favorites. It is not sent in the request body and is used only as a header.",
            "example": "eE2xw7h3pK0mQ1vR8sY4zA6bC9dE3fG5hJ7kL2nP"
        },
        "Authorization": {
            "type": "string",
            "required": false,
            "description": "Bearer token for authenticated customers. Example: Authorization: Bearer {token}",
            "example": "Bearer 1|4WHKo6K0AZNGiPiL9QWs1qXZ2CwnYbaCQyfUYr8M1f224977"
        }
    },
    "endpoints": [
        {
            "path": "/cart",
            "method": "get",
            "summary": "Get active cart",
            "description": "Returns the active cart for an authenticated customer or a guest.\nFor authenticated customers, the active cart is resolved by customer_id.\nFor guests, only the X-Guest-Token header is used.\nIf token is missing and backend creates a new guest cart, the response returns data.token. The client must send that token as X-Guest-Token in the next guest Cart, Compare and Favorites requests.",
            "authorization": false,
            "query": {},
            "formData": false,
            "formBody": {},
            "responses": {
                "200": {
                    "success": true,
                    "message": "Cart loaded successfully",
                    "data": {
                        "id": 12,
                        "status": "active",
                        "customer_id": null,
                        "token": "eE2xw7h3pK0mQ1vR8sY4zA6bC9dE3fG5hJ7kL2nP",
                        "currency": "AZN",
                        "promo": null,
                        "totals": {
                            "subtotal": 120.0,
                            "discount": 0.0,
                            "total": 120.0
                        },
                        "items": [
                            {
                                "id": 55,
                                "product_variation_id": 101,
                                "product_id": 10,
                                "qty": 2,
                                "price": 60.0,
                                "line_total": 120.0,
                                "created_at": "2026-02-06T10:30:00.000000Z",
                                "updated_at": "2026-02-06T10:35:00.000000Z"
                            }
                        ],
                        "merged_at": null,
                        "expired_at": null,
                        "converted_at": null,
                        "created_at": "2026-02-06T10:20:00.000000Z",
                        "updated_at": "2026-02-06T10:35:00.000000Z"
