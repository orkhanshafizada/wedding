                "500": {
                    "success": false,
                    "message": "Server Error",
                    "data": []
                }
            }
        },
        {
            "path": "/cart/items",
            "method": "post",
            "summary": "Add item to cart",
            "description": "Adds a product variation to the cart.\nFor guests, only the X-Guest-Token header is used.\nRecommended flow: create a guest token once with POST /v1/guest-token and send it as X-Guest-Token.\nIf the same variation already exists in the cart, qty is increased.",
            "authorization": false,
            "query": {},
            "formData": false,
            "formBody": {
                "product_variation_id": {
                    "type": "number",
                    "required": true,
                    "description": "Product variation ID to add.",
                    "default": 101
                },
                "qty": {
                    "type": "number",
                    "required": false,
                    "description": "Quantity to add. Default is 1, minimum is 1.",
                    "default": 1
                }
            },
            "responses": {
                "201": {
                    "success": true,
                    "message": "Item added successfully",
                    "data": {
                        "id": 12,
                        "status": "active",
                        "customer_id": null,
                        "token": "eE2xw7h3pK0mQ1vR8sY4zA6bC9dE3fG5hJ7kL2nP",
                        "currency": "AZN",
                        "promo": null,
                        "totals": {
                            "subtotal": 120.0,
                            "discount": 0.0,
                            "total": 120.0
                        },
                        "items": [
                            {
                                "id": 55,
                                "product_variation_id": 101,
                                "product_id": 10,
                                "qty": 2,
                                "price": 60.0,
                                "line_total": 120.0
                            }
                        ],
                        "created_at": "2026-02-06T10:20:00.000000Z",
                        "updated_at": "2026-02-06T10:35:00.000000Z"
                    }
