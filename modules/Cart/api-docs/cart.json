                "500": {
                    "success": false,
                    "message": "Server Error",
                    "data": []
                }
            }
        },
        {
            "path": "/cart/items/{variationId}",
            "method": "patch",
            "summary": "Update cart item quantity",
            "description": "Updates cart item quantity by product variation route parameter.\nFor guests, only the X-Guest-Token header is used.\nqty is required.\nIf qty is 0, the item is removed from the cart.",
            "authorization": false,
            "query": {},
            "formData": false,
            "formBody": {
                "qty": {
                    "type": "number",
                    "required": true,
                    "description": "Final quantity for this cart item. Use 0 to remove the item.",
                    "default": 1
